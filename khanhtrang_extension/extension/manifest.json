{
  "manifest_version": 3,
  "name": "Khánh Trang · Nghe bản tin",
  "version": "0.7.0",
  "description": "Trình đọc bản tin với audio phát từ bộ nhớ, tránh chặn phát trên trang báo.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở trình đọc Khánh Trang"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}